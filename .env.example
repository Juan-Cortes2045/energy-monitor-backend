# Copia este archivo a .env y reemplaza cada CHANGE_ME. Esta en .gitignore: nunca lo subas.
#
# Spring lo lee con formato .properties, asi que escribe sin comillas y sin $:
# un valor con $ se interpreta como marcador de posicion y el arranque falla.

# Base de datos. docker compose usa estas dos para crear el usuario y el esquema.
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

# La misma contrasena que MYSQL_PASSWORD, pero para Spring. La necesitan los tests que activan
# el perfil "test", porque ese perfil no carga application-local.yaml. Vacia a proposito: sin
# ella la suite falla con "Access denied" en vez de conectar como nadie.
SPRING_DATASOURCE_PASSWORD=

# Correo de recuperacion de contrasena (SMTP).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=support.yourapp@gmail.com
MAIL_PASSWORD=CHANGE_ME_contrasena_de_aplicacion_16_caracteres
MAIL_FROM=Energy Monitor <support.yourapp@gmail.com>
