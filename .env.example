# Copy this file to .env and replace every CHANGE_ME. It is in .gitignore: never commit it.
#
# Spring reads it in .properties format, so write values without quotes and without $:
# a value containing $ is treated as a placeholder and the application fails to start.

# Database. MySQL runs from the infra repository (infra/docker-compose.yml), which creates the
# energy_app user with MYSQL_PASSWORD of infra/.env. Put that same password here: it is needed by
# the tests that activate the "test" profile, because that profile does not load
# application-local.yaml. Left empty on purpose: without it the suite fails with "Access denied"
# instead of connecting as nobody.
SPRING_DATASOURCE_PASSWORD=
# Do not set SPRING_DATASOURCE_USERNAME here unless it is energy_app (the user infra creates):
# a different value overrides the test profile and fails with "Access denied".

# HTTP port. The clients go through the API gateway on 8080; the security service is on 8082.
# SERVER_PORT=8083

# Password recovery, verification and alert email (SMTP).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=support.yourapp@gmail.com
MAIL_PASSWORD=CHANGE_ME_app_password_16_characters
MAIL_FROM=Energy Monitor <support.yourapp@gmail.com>

# Frontend origin the browser may use against this service directly. Behind the API gateway it is
# not used: the gateway answers CORS and drops Origin, so set it in the gateway's .env instead.
# SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Message broker (RabbitMQ, infra) ──────────────────────────────────────────────────────────
# Account events and mail requests published by the security service. The consumers are active,
# so without a reachable broker the health check reports DOWN.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=energy-monitor
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password

# ── Device service (README section 12) ────────────────────────────────────────────────────────
# Where the device service answers its internal API (devices of a reading, of a home). The calls
# carry INTERNAL_API_TOKEN.
DEVICE_SERVICE_URL=http://localhost:8084

# ── Measurement service ───────────────────────────────────────────────────────────────────────
# Where the measurement service answers its internal API (consumption levels, hourly energy,
# reporting devices). The calls carry INTERNAL_API_TOKEN. The readings themselves, and their MQTT
# subscription, are the measurement service's.
MEASUREMENT_SERVICE_URL=http://localhost:8085

# ── Alert notifications (README section 10) ─────────────────────────────────────────────────
# Base URL of the web app, used by the links in alert mail.
NOTIFICATION_WEB_URL=http://localhost:5173
# Web Push (VAPID) key pair. Generate once per environment and keep it: regenerating it
# invalidates every browser subscription. Empty = push disabled, mail still works.
#   openssl ecparam -name prime256v1 -genkey -noout -out vapid.pem
#   openssl ec -in vapid.pem -outform DER | tail -c +8 | head -c 32 | base64 -w0 | tr '+/' '-_' | tr -d '='   # private
#   openssl ec -in vapid.pem -pubout -outform DER | tail -c 65 | base64 -w0 | tr '+/' '-_' | tr -d '='        # public
#   rm vapid.pem
NOTIFICATION_VAPID_PUBLIC_KEY=
NOTIFICATION_VAPID_PRIVATE_KEY=

# Credential to send push to the mobile apps through the Expo relay. It travels as
# "Authorization: Bearer <token>" on the push API, and is only *required* if push security is
# enabled for the project; without it the relay accepts the request anyway, but then anyone who
# gets hold of a push token could send your users whatever they like, so it is not optional here.
#
# Where: expo.dev → your project → the push notifications section, or create a Personal access
# token at https://expo.dev/settings/access-tokens. Same value either way for this purpose.
#
# Empty = app push disabled; mail, alerts and web push keep working.
#
# SERVER-SIDE ONLY. Never put this in the mobile app's .env: Expo inlines every EXPO_PUBLIC_*
# variable into the APK, where anyone who downloads it can read it. Note this variable has no
# EXPO_PUBLIC_ prefix on purpose.
EXPO_ACCESS_TOKEN=

# ── Consumption recommendations (README section 11) ───────────────────────────────────────────
# Optional. How often the rules run and the zone of the day-part rules (evening peak, night standby).
# RECOMMENDATION_EVALUATE_INTERVAL=PT1H
# RECOMMENDATION_ZONE=America/Bogota
# Zone in which the day and the month of the consumption limit alert start.
# ALERT_LIMIT_ZONE=America/Bogota

# ── Security service (en-monitor-security-service) ───────────────────────────────────────────
# It signs the access tokens; this backend validates them with its public key only (absolute
# path, the same file as the service's SECURITY_JWT_PUBLIC_KEY_PATH; never the private key).
SECURITY_JWT_PUBLIC_KEY_PATH=/home/you/.energy-monitor/keys/public.pem
# Where its internal API answers.
SECURITY_SERVICE_URL=http://localhost:8082
# Calls between this backend and the security service. The same token goes in both .env files;
# generate one with: openssl rand -hex 32
INTERNAL_API_TOKEN=CHANGE_ME_internal_api_token
