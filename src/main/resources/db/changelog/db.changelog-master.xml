<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

        <!--
            The measurement changesets (measurement-001 onwards), the home ones (home-001 onwards)
            and the notification ones (notification-001 onwards) moved to the measurement, home and
            notification services with the same path, like the security and device ones: each
            service applies its own, and the rows of the shared DATABASECHANGELOG keep recording
            them as applied. alert and recommendation refer to a home by its identifier only, with
            no foreign key, so they do not need the home tables.
        -->
        <include file="alert/alert-changelog.xml" relativeToChangelogFile="true"/>
        <include file="recommendation/recommendation-changelog.xml" relativeToChangelogFile="true"/>
        <include file="outbox/outbox-changelog.xml" relativeToChangelogFile="true"/>
</databaseChangeLog>