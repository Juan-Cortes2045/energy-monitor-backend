<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

        <!--
            The measurement changesets (measurement-001 onwards) moved to the measurement service
            with the same path, like the security and device ones: it applies them, and the rows of
            the shared DATABASECHANGELOG keep recording them as applied.
        -->
        <include file="home/home-changelog.xml" relativeToChangelogFile="true"/>
        <include file="alert/alert-changelog.xml" relativeToChangelogFile="true"/>
        <include file="recommendation/recommendation-changelog.xml" relativeToChangelogFile="true"/>
        <include file="notification/notification-changelog.xml" relativeToChangelogFile="true"/>
</databaseChangeLog>