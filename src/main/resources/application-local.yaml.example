# Local profile: copy to application-local.yaml (gitignored) and set the database password.
#
# Only what differs per machine lives here. The MQTT broker, device provisioning and alert
# notification settings are read from .env (see .env.example and README sections 9 and 10),
# so this file does not need them.

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/energy_monitor?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
    username: energy_app
    password: "CHANGE_ME"

security:
  jwt:
    issuer: https://energy-monitor-backend
    # The public key of the security service (its SECURITY_JWT_PUBLIC_KEY_PATH), or leave it
    # empty here and export the environment variable instead. Empty is deliberate: the
    # application then refuses to start with a message naming the variable. This backend never
    # holds the private key. The path must be absolute: Java does not expand ~ .
    public-key-path: ${SECURITY_JWT_PUBLIC_KEY_PATH:}

  cors:
    # Origins allowed to call this API from a browser. Comma separated; leave empty to answer no
    # cross-origin caller at all. The React Native client does not go through CORS, so it is
    # unaffected by this list.
    allowed-origins: "http://localhost:5173,http://127.0.0.1:5173"
    allow-credentials: false
  device:
    # provisioning:
    # LAN IP of this PC on the current network (the moto g56 hotspot). Modules are told to
    # reach the broker on it over TLS. Update it when the PC changes of network, together
    # with the broker certificate (docker/mosquitto/generate-dev-certs.sh).
    mqtt-host: 10.123.34.104
